# Database
prisma/dev.db
prisma/*.db

# SQLite databases are local state, never source (ADR-029/030). This is a
# catch-all: the explicit paths below stay for documentation, but a new DB in
# any directory must never be able to slip into a commit.
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/*.sqlite-journal

