CLAUDE.local.md
*.local.md
heartbeat.md


# APM dependencies
apm_modules/

# VADER lexicon downloaded on first news-sentiment run (news_sentiment.py)
investment_screener/backend/data/nltk_data/

# CodeGraph local index and runtime state: rebuilt per checkout, machine-local,
# never source. Keeps the nested .codegraph/.gitignore as the tracked spec while
# this rule protects the whole directory (the index alone is tens of MB).
.codegraph/*
!.codegraph/.gitignore
