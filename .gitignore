# Backend cache
investment_screener/backend/py_services/cache/
investment_screener/backend/data/cache/
plugins/stock-valuation/scripts/cache/
# Legacy JSON fetch caches (now SQLite fetch_cache); guard against a symlinked script writing one in a skill folder
plugins/*/skills/*/scripts/cache/

# Machine-local skill install state, rewritten by the plugin manager on every sync
skills-lock.json

# Intelligence read-model DB (derived/rebuildable from observations.jsonl, never committed — ADRs/026-028)
investment_screener/backend/data/intelligence.sqlite
investment_screener/backend/data/intelligence.sqlite-wal
investment_screener/backend/data/intelligence.sqlite-shm

# Domain-model DB — the SOLE source of truth for holdings, accounts, targets and thesis data
# (ADR-029/030). Never committed and NOT rebuildable from git: protected by db_backup.py instead.
investment_screener/backend/data/domain_model.sqlite
investment_screener/backend/data/domain_model.sqlite-wal
investment_screener/backend/data/domain_model.sqlite-shm

# Verified SQLite backups written by db_backup.py (startup, pre-migration, pre-restore)
investment_screener/backend/data/backups/

# Runtime secrets (generated at startup, never committed)
.runtime/

# Test coverage output
coverage/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Personal trading data (user-specific, cannot be recovered from git)
investment_screener/backend/data/observations.jsonl
investment_screener/backend/data/intelligence_events.jsonl
investment_screener/backend/data/portfolio_snapshot.json
investment_screener/backend/data/ytd_performance_report.json
